# syntax=docker/dockerfile:1.7
# Public CiteRAG Lite demo image for the Northflank free Sandbox plan.
#
# The free plan is limited to 0.2 vCPU / 512 MB, which cannot host the PyTorch +
# MiniLM + LanceDB semantic stack. This image serves the same dashboard and REST
# shape using CiteRAG's documented standard-library SQLite FTS5 fallback. It
# indexes public project documentation at build time and runs as a nonroot user.
# It is a public demo, not a production deployment.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CITERAG_DEMO_PUBLIC=1 \
    CITERAG_DEMO_ALLOW_REINDEX=0 \
    CITERAG_WEB_HOST=0.0.0.0 \
    CITERAG_WEB_PORT=18762 \
    HOME=/app \
    PYTHONPATH=/app

WORKDIR /app

# The demo only needs the web framework; versions match requirements.lock.txt.
RUN python -m pip install --no-cache-dir "starlette==1.10.0" "uvicorn==0.54.0"

COPY citerag /app/citerag
COPY docs /app/docs

# Build the standard-library FTS5 index; citerag.cli is stdlib-only.
# The public demo stays read-only: CITERAG_DEMO_ALLOW_REINDEX=0 above keeps
# /api/reindex disabled, so the image never needs a writable data volume.
RUN python -m citerag.cli ingest \
    && chown -R 65532:65532 /app

USER 65532:65532
EXPOSE 18762

CMD ["python", "-m", "citerag.demo_web"]
